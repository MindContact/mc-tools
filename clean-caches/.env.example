# Copy to .env (git-ignored) and adjust to this machine.
# Every value is optional: unset ones fall back to the defaults shown.

# Android SDK root (default: $ANDROID_SDK_ROOT, $ANDROID_HOME, then ~/Android/Sdk)
ANDROID_SDK_ROOT=$HOME/Android/Sdk

# AVD kept by `clean-caches.sh avd`, and the image used to recreate it
KEEP_AVD=lite
KEEP_AVD_IMAGE="system-images;android-34;google_apis;x86_64"
